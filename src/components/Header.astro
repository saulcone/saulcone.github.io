---
import Icon from "./Icon.astro";
import { getText, homePath, profile } from "../lib/content.js";

const { lang } = Astro.props;
const text = getText(lang);
// Each language is named in itself, so a visitor recognises their own.
const languages = [
  { code: "es", name: "Español" },
  { code: "en", name: "English" },
];
const links = ["projects", "featured", "experience", "skills", "education", "about", "contact"];
---

<a class="skip-link" href="#main">
  {text.a11y.skip}
</a>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={homePath(lang)}>
      <img src="/img/logo.webp" alt="" width="58" height="32" />
      {profile.name}
    </a>
    <nav class="site-nav" aria-label={text.a11y.nav}>
      <ul>
        {links.map((id) => (
          <li>
            <a href={`#${id}`}>{text.nav[id]}</a>
          </li>
        ))}
      </ul>
    </nav>
    <details class="lang-menu" data-lang-menu>
      <summary>
        <span class="visually-hidden">{`${text.a11y.language}: `}</span>
        {lang.toUpperCase()}
        <Icon name="chevronDown" />
      </summary>
      <ul class="lang-menu__list">
        {languages.map((item) => (
          <li>
            <a
              href={homePath(item.code)}
              hreflang={item.code}
              lang={item.code}
              aria-current={item.code === lang ? "page" : undefined}
            >
              {item.name}
              {item.code === lang && <Icon name="check" />}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</header>

<script>
  // Native <details> opens and closes by itself; this adds Escape and clicking outside.
  const menu = document.querySelector("[data-lang-menu]");
  document.addEventListener("click", (event) => {
    if (menu.open && !menu.contains(event.target)) menu.open = false;
  });
  menu.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu.open) {
      menu.open = false;
      menu.querySelector("summary").focus();
    }
  });
</script>
