---
import Icon from "./Icon.astro";
import { getText, localized, profile } from "../lib/content.js";

const { lang } = Astro.props;
const text = getText(lang).projects;
const newTab = getText(lang).a11y.newTab;
// The featured project has its own section right below.
const projects = profile.projects.filter((project) => !project.featured);

const linksOf = ({ links }) =>
  [
    { href: links.repo, label: links.frontend ? text.backend : text.repo, icon: "github" },
    { href: links.frontend, label: text.frontend, icon: "github" },
    { href: links.demo, label: text.demo, icon: "external" },
  ].filter((link) => link.href);
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="section__head">
      <h2 id="projects-title">{text.title}</h2>
      <p class="section__lead">{text.lead}</p>
    </div>
    <div
      class="carousel"
      data-carousel
      role="group"
      aria-roledescription={text.carousel}
      aria-labelledby="projects-title"
    >
      <ul class="carousel__track" data-track>
        {projects.map((project) => (
          <li class="project">
            <div class="project__media">
              {project.image ? (
                <img
                  src={project.image.src}
                  alt={localized(project.image.alt, lang)}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="project__placeholder">
                  <Icon name="code" />
                </span>
              )}
            </div>
            <div class="project__body">
              <div>
                <h3>{localized(project.title, lang)}</h3>
                <p class="card__type mono">{localized(project.type, lang)}</p>
              </div>
              <p>{localized(project.summary, lang)}</p>
              {project.contribution && (
                <p class="project__part">{localized(project.contribution, lang)}</p>
              )}
              <ul class="chips" aria-label="Stack">
                {project.stack.map((item) => (
                  <li class="chip">{localized(item, lang)}</li>
                ))}
              </ul>
              <div class="card__foot">
                {project.status === "in_progress" && <span class="badge">{text.inProgress}</span>}
                {linksOf(project).map((link) => (
                  <a class="btn btn--small" href={link.href} target="_blank" rel="noopener">
                    <Icon name={link.icon} />
                    {link.label}
                    <span class="visually-hidden">
                      {localized(project.title, lang)} {newTab}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          </li>
        ))}
      </ul>
      <div class="carousel__bar" data-bar hidden>
        <p class="mono" data-status aria-live="polite"></p>
        <div class="carousel__buttons">
          <button class="btn btn--small" type="button" data-prev aria-label={text.prev}>
            <Icon name="chevronLeft" />
          </button>
          <button class="btn btn--small" type="button" data-next aria-label={text.next}>
            <Icon name="chevronRight" />
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Without JS the track still scrolls by touch or trackpad; this adds the arrows.
  const carousel = document.querySelector("[data-carousel]");
  const track = carousel.querySelector("[data-track]");
  const bar = carousel.querySelector("[data-bar]");
  const status = carousel.querySelector("[data-status]");
  const prev = carousel.querySelector("[data-prev]");
  const next = carousel.querySelector("[data-next]");
  const slides = [...track.children];
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

  const step = () => (slides[1] ? slides[1].offsetLeft - slides[0].offsetLeft : track.clientWidth);

  const update = () => {
    const visible = Math.max(1, Math.round(track.clientWidth / step()));
    const first = Math.round(track.scrollLeft / step()) + 1;
    const last = Math.min(first + visible - 1, slides.length);
    const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;

    bar.hidden = track.scrollWidth <= track.clientWidth + 1;
    status.textContent = `${first === last ? first : `${first}–${last}`} / ${slides.length}`;
    prev.setAttribute("aria-disabled", String(track.scrollLeft <= 1));
    next.setAttribute("aria-disabled", String(atEnd));
  };

  const move = (direction) =>
    track.scrollBy({ left: direction * step(), behavior: calm.matches ? "auto" : "smooth" });

  prev.addEventListener("click", () => move(-1));
  next.addEventListener("click", () => move(1));
  track.addEventListener("scroll", update, { passive: true });
  new ResizeObserver(update).observe(track);
</script>
