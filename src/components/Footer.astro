---
import { getText, profile } from "../lib/content.js";

const { lang } = Astro.props;
const text = getText(lang).footer;
const repo = profile.projects.find((project) => project.id === "portfolio").links.repo;
---

<footer class="site-footer dark">
  <div class="container">
    <p>
      © 2026 {profile.name} · {text.built} · <a href={repo}>{text.code}</a>
    </p>
  </div>
</footer>
