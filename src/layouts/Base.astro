---
import "@fontsource-variable/inter";
import "@fontsource/jetbrains-mono/400.css";
import "../styles/global.css";
import { getText, homePath, localized, profile } from "../lib/content.js";

const { lang, title, description, noindex = false } = Astro.props;
const text = getText(lang);
const site = profile.site;
const canonical = new URL(homePath(lang), site).href;
const ogImage = new URL("/og-image.png", site).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: localized(profile.role, lang),
  url: canonical,
  sameAs: [profile.contact.linkedin, profile.contact.github],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? text.meta.title}</title>
    <meta name="description" content={description ?? text.meta.description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL("/", site).href} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f6f6f3" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title ?? text.meta.title} />
    <meta property="og:description" content={description ?? text.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={text.meta.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? text.meta.title} />
    <meta name="twitter:description" content={description ?? text.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <slot />
  </body>
</html>
